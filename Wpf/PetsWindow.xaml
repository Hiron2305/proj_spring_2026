<Window x:Class="petchelterWPF.PetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Таблица питомцев" Height="450" Width="800" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="PetsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="0" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Кличка" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Возраст" Binding="{Binding Age}"/>  
                <DataGridTextColumn Header="Вес" Binding="{Binding Weight}"/>
                <DataGridTextColumn Header="Пол" Binding="{Binding Gender}"/>
                <DataGridCheckBoxColumn Header="Клаустрофобия" Binding="{Binding Claustrophobia}"/>
                <DataGridTextColumn Header="Тип/Детали" Binding="{Binding PetDetails, Mode=OneWay}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddPetBtn" Content="Добавить питомца" Click="AddPet_Click" Width="150" Height="30" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button x:Name="RemovePetBtn" Content="Удалить выбранного" Click="RemovePet_Click" Width="150" Height="30" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button Content="Сохранить подборку в файл" Click="SaveReport_Click" Width="200" Height="30" />
        </StackPanel>
    </Grid>
</Window>