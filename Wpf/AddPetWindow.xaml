<Window x:Class="petchelterWPF.AddPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый питомец" Width="350" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <Label Content="Тип животного:" FontWeight="Bold"/>
        <ComboBox x:Name="TypeComboBox" SelectionChanged="TypeComboBox_SelectionChanged" Margin="0,0,0,10">
            <ComboBoxItem Content="Кот" IsSelected="True"/>
            <ComboBoxItem Content="Собака"/>
            <ComboBoxItem Content="Кролик"/>
        </ComboBox>

        <Label Content="Кличка:"/>
        <TextBox x:Name="NameTextBox" Margin="0,0,0,5"/>

        <Label Content="Возраст (полных лет):"/>
        <TextBox x:Name="AgeTextBox" Margin="0,0,0,5"/>

        <Label Content="Вес (кг):"/>
        <TextBox x:Name="WeightTextBox" Margin="0,0,0,5"/>

        <Label Content="Пол:"/>
        <ComboBox x:Name="GenderComboBox" Margin="0,0,0,10">
            <ComboBoxItem Content="Male" IsSelected="True"/>
            <ComboBoxItem Content="Female"/>
        </ComboBox>

        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,5,0,10" CornerRadius="5">
            <StackPanel>
                <Label x:Name="ExtraLabel1" Content="Порода:"/>
                <TextBox x:Name="ExtraTextBox1" Margin="0,0,0,10"/>

                <CheckBox x:Name="ExtraCheckBox" Content="Кастрирован(а)"/>

                <Label x:Name="ExtraLabel2" Content="Количество детей:" Visibility="Collapsed"/>
                <TextBox x:Name="ExtraTextBox2" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <CheckBox x:Name="ClaustrophobiaCheckBox" Content="Страдает клаустрофобией" Foreground="Red" FontWeight="Bold"/>

        <Button Content="Добавить в приют" Click="AddButton_Click" Height="35" Margin="0,20,0,0" Background="LightGreen"/>
    </StackPanel>
</Window>